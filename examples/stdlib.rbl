// Standard-library builtins: len, int_to_string, string_to_int, bool_to_int,
// int_to_bool, bool_to_string, string_to_bool, char_at, substring, index_of,
// trim, upper, and lower. The ordering comparisons <, <=, >, >= also compare
// two strings lexicographically by Unicode scalar value. Indexes count
// characters (Unicode scalar values), not UTF-8 bytes.
// Run with: cargo run -- --file examples/stdlib.rbl
let count = len("héllo");                    // 5: characters, not UTF-8 bytes
let text = int_to_string(-12);               // "-12"
let number = string_to_int("007");           // 7: leading zeros accepted
let flag = int_to_bool(bool_to_int(1 < 2));  // true: 1 is true, 0 is false
let shown = bool_to_string(flag);            // "true": boolean literal spelling
let parsed = string_to_bool("false");        // false: only "true"/"false" accepted
let character = char_at("héllo", 1);         // "é": index 1 by characters
let piece = substring("hello", 1, 3);        // "el": end-exclusive slice
let found = index_of("hello", "ll");         // 2: first occurrence, or -1
let clean = trim("  pad  ");                 // "pad": surrounding whitespace gone
let loud = upper("mixed");                   // "MIXED": Unicode case mapping
let quiet = lower("MIXED");                  // "mixed"
let ordered = "apple" < "banana";            // true: lexicographic order

count == 5 && text == "-12" && number == 7 && flag
  && shown == "true" && !parsed && character == "é" && piece == "el"
  && found == 2 && clean == "pad" && loud == "MIXED" && quiet == "mixed"
  && ordered && "a" <= "a"
